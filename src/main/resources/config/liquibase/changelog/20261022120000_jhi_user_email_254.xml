<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        JHipster crea jhi_user.email como varchar(191), pero la entidad User y el DTO admiten hasta
        254 caracteres (CU-01, contrato §5.1). Changeset nuevo en vez de editar el inicial, que ya
        está aplicado (ADR 0002). El índice único ux_user_email se conserva.
    -->
    <changeSet id="20261022120000-1" author="turnos-service">
        <modifyDataType tableName="jhi_user" columnName="email" newDataType="varchar(254)"/>
    </changeSet>
</databaseChangeLog>
