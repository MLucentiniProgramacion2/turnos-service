# Copiar a .env (ignorado por Git) y completar con valores reales:
#   cp .env.example .env
# Nunca commitear .env ni pegar sus valores en issues, PRs o logs.

# --- Base de datos propia del servicio (PostgreSQL) ---
# Host de la base; por defecto localhost (la de docker compose up -d).
TURNOS_DB_HOST=localhost
TURNOS_DB_NAME=turnos
TURNOS_DB_USER=turnos_app
TURNOS_DB_PASSWORD=cambiar_esto
# Puerto del host; distinto del de catálogo (5433) para levantar los dos a la vez.
TURNOS_DB_PORT=5434
# TURNOS_DB_HOST y TURNOS_DB_PORT son para ./mvnw desde el host. En el contenedor de la aplicación el
# docker-compose.yml las pisa (turnos-db y 5432); TURNOS_DB_PORT sigue publicando la base en el host.

# --- Aplicación en Docker Compose (opcional) ---
# Interfaz del host donde se publica el 8080. Por defecto 127.0.0.1 (el emulador de Android entra por 10.0.2.2).
# Para un teléfono físico, la IP de la red local. Nunca 0.0.0.0: abriría el puerto también en ZeroTier.
#TURNOS_APP_BIND=127.0.0.1

# --- Clave de firma del JWT (HS512, ver docs/adr/0003-emision-jwt-y-usuarios.md) ---
# Generar con:  openssl rand -base64 64 | tr -d '\n'
# Usar EXACTAMENTE el mismo valor en catalogo-service: turnos firma los tokens
# con esta clave y el catálogo los valida con ella.
# Si queda vacía o falta, la aplicación no arranca.
JWT_BASE64_SECRET=

# --- API REST de la cátedra (ver docs/adr/0004-cliente-http-catedra.md) ---
# Los mismos valores que en catalogo-service. Solo accesible por ZeroTier.
# Si falta la URL o el token, la aplicación no arranca.
CATEDRA_API_URL=
# JWT técnico de la cuenta del proyecto (vale un año). Nunca en logs, issues ni PRs.
CATEDRA_JWT=
# Opcionales (DPT-08): por defecto 2s para conectar y 5s para la respuesta completa.
#CATEDRA_CONNECT_TIMEOUT=2s
#CATEDRA_READ_TIMEOUT=5s

# --- Token técnico de servicio hacia el catálogo (ver docs/adr/0005-token-de-servicio.md) ---
# Opcional: vida del token, de 30s a 5m (por defecto 5m). Con más de 5m la aplicación no arranca,
# porque el catálogo rechazaría cada pedido con 403.
#SERVICE_TOKEN_LIFETIME=5m

# --- Servicio de catálogo (agenda vigente, CU-07 del catálogo) ---
# Si falta, la aplicación no arranca. Local: http://localhost:8081
# En el contenedor el docker-compose.yml la pisa con host.docker.internal:8081 (el catálogo, en ./mvnw o en
# su Compose, por el host).
CATALOGO_API_URL=
# Opcionales (DPT-13): por defecto 2s para conectar y 5s para la respuesta completa.
#CATALOGO_CONNECT_TIMEOUT=2s
#CATALOGO_READ_TIMEOUT=5s

# --- Kafka de la cátedra (ver docs/adr/0006-kafka-en-turnos.md) ---
# Valores de GET /api/student/integration. Solo accesible por ZeroTier. Si falta alguno, la aplicación no arranca.
# Bootstrap: kafkaBootstrapServers (el mismo que en catalogo-service).
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
# Topic de acciones: kafkaAppointmentActionsTopic (pedido de teléfono y resultados de la reserva).
CATEDRA_KAFKA_ACTIONS_TOPIC=
# Grupo propio de turnos: kafkaConsumerGroupId con el sufijo -turnos. Nunca el de catalogo-service.
CATEDRA_KAFKA_CONSUMER_GROUP=
# Topic de teléfono: kafkaAppointmentPhoneTopic (ahí se publica AdditionalInformationSubmitted).
CATEDRA_KAFKA_PHONE_TOPIC=
# groupId de la integración: va en cada AdditionalInformationSubmitted.
CATEDRA_GROUP_ID=

# --- Reglas de fechas de la reserva (DPT-10) ---
# Opcionales: zona horaria de atención y cuántos días hacia adelante se ofrecen turnos.
#RESERVATION_TIME_ZONE=America/Argentina/Mendoza
#RESERVATION_BOOKING_HORIZON_DAYS=60
