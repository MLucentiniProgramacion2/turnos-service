# Copiar a .env (ignorado por Git) y completar con valores reales:
#   cp .env.example .env
# Nunca commitear .env ni pegar sus valores en issues, PRs o logs.

# --- Base de datos propia del servicio (PostgreSQL) ---
# Host de la base; por defecto localhost (la de docker compose up -d).
TURNOS_DB_HOST=localhost
TURNOS_DB_NAME=turnos
TURNOS_DB_USER=turnos_app
TURNOS_DB_PASSWORD=cambiar_esto
# Puerto del host; distinto del de catálogo (5433) para levantar los dos a la vez.
TURNOS_DB_PORT=5434

# --- Clave de firma del JWT (HS512, ver docs/adr/0003-emision-jwt-y-usuarios.md) ---
# Generar con:  openssl rand -base64 64 | tr -d '\n'
# Usar EXACTAMENTE el mismo valor en catalogo-service: turnos firma los tokens
# con esta clave y el catálogo los valida con ella.
# Si queda vacía o falta, la aplicación no arranca.
JWT_BASE64_SECRET=

# --- API REST de la cátedra (ver docs/adr/0004-cliente-http-catedra.md) ---
# Los mismos valores que en catalogo-service. Solo accesible por ZeroTier.
# Si falta la URL o el token, la aplicación no arranca.
CATEDRA_API_URL=
# JWT técnico de la cuenta del proyecto (vale un año). Nunca en logs, issues ni PRs.
CATEDRA_JWT=
# Opcionales (DPT-08): por defecto 2s para conectar y 5s para la respuesta completa.
#CATEDRA_CONNECT_TIMEOUT=2s
#CATEDRA_READ_TIMEOUT=5s
